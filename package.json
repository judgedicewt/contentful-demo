{
  "name": "contentful-demo",
  "version": "0.1.0",
  "private": true,
  "description": "McLaren-style automotive demo on Contentful: provisions the content model, seeds vehicles and pages, and serves a static front end.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node scripts/check.js",
    "setup": "node scripts/setup.js",
    "fetch": "node scripts/fetch.js",
    "build:site": "node scripts/build-site.js",
    "dev": "npm run build:site && node scripts/serve.js",
    "teardown:blog": "node scripts/teardown-blog.js",
    "placeholders": "node scripts/generate-placeholders.js",
    "verify": "node scripts/verify-content.js",
    "test": "node --test"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "contentful": "^11.0.0",
    "contentful-management": "^11.0.0",
    "dotenv": "^16.4.5"
  }
}
